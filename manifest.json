{
  "manifest_version": 3,
  "name": "Spotify Crack",
  "version": "1.0",
  "description": "Spotify Crack!",
  "icons": {
    "128": "img/icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://spotify.com*"], 
      "css": ["style.css"]
    }
  ],
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://spotify.com*",
    "https://*.audio-ak-spotify-com.akamaized.net/*",
    "https://*.googlesyndication.com/*",
    "https://*.audio-akp-quic-spotify-com.akamaized.net/*",
    "https://spotify.com*"
  ],
  "declarative_net_request": {
    "rule_resources": [{
      "id": "ruleset_1",
      "enabled": true,
      "path": "rules.json"
    }]
  }
}